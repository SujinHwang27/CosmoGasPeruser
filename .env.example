# AWS Configuration (for DVC remote / artifact storage)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1

# S3 Buckets
S3_WORKSPACE_BUCKET_NAME=your-workspace-bucket
S3_ARCHIVE_BUCKET_NAME=your-archive-bucket

# MLflow Configuration
# Option A (local SQLite + S3 artifacts):
#   MLFLOW_TRACKING_URI=sqlite:///mlflow.db
#   MLFLOW_ARTIFACT_ROOT=s3://cosmo-gas-peruser/mlflow-artifacts
# Option B (remote server):
#   MLFLOW_TRACKING_URI=http://<server-ip>:5000
# Option C (fully S3-native, no local state):
#   MLFLOW_TRACKING_URI=s3://cosmo-gas-peruser/mlflow-backend
#   MLFLOW_ARTIFACT_ROOT=s3://cosmo-gas-peruser/mlflow-artifacts
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_ARTIFACT_ROOT=s3://cosmo-gas-peruser/mlflow-artifacts
# Note: experiment names are auto-generated per-branch via provenance.py
# Do NOT set MLFLOW_EXPERIMENT_NAME — use mlflow_experiment_name() in code

# Airflow (optional)
AIRFLOW_HOME=~/airflow
