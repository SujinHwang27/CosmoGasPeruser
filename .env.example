# AWS Configuration (for DVC remote / artifact storage)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1

# S3 Buckets
S3_WORKSPACE_BUCKET_NAME=your-workspace-bucket
S3_ARCHIVE_BUCKET_NAME=your-archive-bucket

# MLflow Configuration
# Backend: SQLite (local, synced across machines via DVC)
# Artifacts: S3 (shared, any machine with AWS creds sees plots/models)
# To view: uv run mlflow ui --backend-store-uri sqlite:///mlflow.db
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_ARTIFACT_ROOT=s3://cosmo-gas-peruser/mlflow-artifacts
# Experiment names are auto-generated per-branch via provenance.py
# Do NOT set MLFLOW_EXPERIMENT_NAME — use mlflow_experiment_name() in code
#
# Multi-machine sync for the SQLite backend:
#   After running experiments:  dvc add mlflow.db && git add mlflow.db.dvc && git push && dvc push
#   Before reviewing on another machine:  git pull && dvc pull mlflow.db

# Airflow (optional)
AIRFLOW_HOME=~/airflow
